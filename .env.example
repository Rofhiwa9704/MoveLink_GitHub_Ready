POSTGRES_DB=movelink_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
APP_CORS_ORIGINS=http://localhost

# Optional SMTP settings. Leave blank if email is not enabled yet.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Optional: create the first admin automatically on startup.
MOVELINK_ADMIN_EMAIL=
MOVELINK_ADMIN_PASSWORD=

# At least 32 bytes; use a long random value in production.
MOVELINK_JWT_SECRET=change-this-to-a-long-random-secret
MOVELINK_JWT_EXPIRATION_MS=86400000
